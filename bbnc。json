function run() {
    // 1. 更新为你的最新暗号
    var pvStr = 'RaNWHQ2'; 
    var endStr = 'iA1LaGO';
    
    var data = [];
    // 兼容快捷指令传入的变量
    var More = (typeof configValue !== 'undefined' && configValue) ? configValue : 1;
    var currentRunNum = (typeof runNum !== 'undefined') ? runNum : 0;

    var taobaoScheme = {
        scheme: "taobao",
        main: "taobao://m.taobao.com/tbopen/index.html?h5Url=https://m.taobao.com",
        start: "taobao://m.tb.cn/h." + pvStr,
        end: "taobao://m.tb.cn/h." + endStr
    };
    
    // 其他平台配置 (天猫/点淘)
    var tmScheme = {
        scheme: "tmall://page.tm/appLink?&action=ali.open.nav&h5Url=",
        main: "tmall://page.tm/appLink?&action=ali.open.nav&h5Url=https%3A%2F%2Fwww.tmall.com%2F",
        start: "tmall://page.tm/appLink?&action=ali.open.nav&h5Url=https://m.tb.cn/h." + pvStr,
        end: "tmall://page.tm/appLink?&action=ali.open.nav&h5Url=https%3A%2F%2Fwww.tmall.com%2F",
        type: "url"
    };

    var schemes = { 1: [taobaoScheme], 2: [tmScheme, taobaoScheme] };
    var scheme = schemes[More] || [taobaoScheme];
    var taskList = DATA.activity.taskList.map(function(v) { return DATA.taskData[v]; });

    scheme.map(function(s) {
        taskList.map(function(oneTask) {
            var itme = oneTask.task.item;
            var before = oneTask.task.before || [];
            var baseUrl = oneTask.task.baseurl;
            var wait = oneTask.task.wait;
            var paramObj = oneTask.task.param;

            // 添加开始暗号页 (最重要的跳转)
            data.push({ url: s.start, wait: 5 });

            // 运行任务列表
            itme.map(function(v, i) {
                var url = baseUrl;
                for (var key in paramObj) {
                    var paramArr = paramObj[key];
                    var reg = new RegExp(key, 'g');
                    url = url.replace(reg, paramArr[Math.floor(Math.random() * paramArr.length)]);
                }
                
                var params = v.split(' ');
                params.map(function(val, idx) {
                    if (val) {
                        url = url.replace(new RegExp('占位参数' + (idx + 1), 'g'), val);
                    }
                });

                data.push({
                    url: s.type ? s.scheme + encodeURIComponent('https' + url) : s.scheme + url,
                    wait: wait
                });

                // 每2个任务回一次主页，防止弹窗卡死
                if (i % 2 === 0) data.push({ url: s.main, wait: 5 });
            });

            // 添加结束暗号页
            data.push({ url: s.end, wait: 5 });
        });
    });

    // 处理分步执行逻辑
    if (currentRunNum > 1) {
        data = data.slice(currentRunNum - 1);
    }

    // 统一输出格式，确保快捷指令能识别到 "url" 键
    return JSON.stringify({
        success: 'ok',
        data: data,
        // 增加一个直观的 url 字段供快捷指令直接读取
        url: data[0] ? data[0].url : "",
        wait: data[0] ? data[0].wait : 5
    });
}

