// 3. 核心运行逻辑 (已针对本地运行优化)
function run() {
    var data = [];
    var configValue = 1; // 默认淘宝形式
    
    var taobaoScheme = {
        scheme: "taobao",
        main: "taobao://m.taobao.com/tbopen/index.html?h5Url=https://m.taobao.com",
        start: "taobao://m.tb.cn/h." + pvStr,
        end: "taobao://m.tb.cn/h." + endStr
    };
    
    var scheme = [taobaoScheme]; 
    var taskList = DATA.activity.taskList.map(function(v) { return DATA.taskData[v]; });

    scheme.map(function(s) {
        taskList.map(function(oneTask) {
            var itme = oneTask.task.item;
            var before = oneTask.task.before;
            var baseUrl = oneTask.task.baseurl;
            var paramObj = oneTask.task.param;

            if (s.start) data.push({ url: s.start, wait: 5 });

            before.map(function(v) {
                data.push({ url: s.scheme + v.url, wait: v.wait });
            });

            itme.map(function(v) {
                var url = baseUrl;
                for (var key in paramObj) {
                    var paramArr = paramObj[key];
                    var randomParam = paramArr[Math.floor(Math.random() * paramArr.length)];
                    url = url.replace(new RegExp(key, 'g'), randomParam);
                }
                url = url.replace(/占位参数1/g, v);
                data.push({ url: s.scheme + url, wait: oneTask.task.wait });
            });
            
            if (s.end) data.push({ url: s.end, wait: 5 });
        });
    });

    // 格式化输出给快捷指令
    return JSON.stringify({ succes: 'ok', data: data });
}

run();
